{
  "expo": {
    "name": "Echo",
    "slug": "my-echo",
    "version": "1.0.0",
    "scheme": "my-echo",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uthsobcb.echo",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo.png",
        "backgroundImage": "./assets/images/logo.png",
        "monochromeImage": "./assets/images/logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.uthsobcb.echo",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/onscreen.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@revopush/expo-code-push-plugin",
        {
          "ios": {
            "CodePushDeploymentKey": "DYsmRU7y1AUPNYVzveK2ipOD39NjNJWJhD4pQl",
            "CodePushServerUrl": "https://api.revopush.org"
          },
          "android": {
            "CodePushDeploymentKey": "DYsmRU7y1AUPNYVzveK2ipOD39NjNJWJhD4pQl",
            "CodePushServerUrl": "https://api.revopush.org"
          }
        }
      ],
      "expo-speech-recognition",
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    }
  }
}