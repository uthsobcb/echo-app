# Echo App — client-safe environment variables
# Copy to .env and fill in your values.

API_BASE_URL=https://echo-next.vercel.app/api

# CodePush (OTA updates) — get these from your Revopush/App Center account.
# Leave blank to build without OTA update checks.
CODEPUSH_DEPLOYMENT_KEY=
CODEPUSH_SERVER_URL=https://api.revopush.org
